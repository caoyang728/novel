# ============================================================
# Novel Agent - 环境配置模板
# 复制此文件为 .env 并根据实际情况修改配置
# cp .env.example .env
# ============================================================

# ==================== Django ====================
# 生产环境请务必修改为随机字符串
SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True           # 生产环境修改为False
DJANGO_ALLOWED_HOSTS=*      # 根据实际情况填写

# ==================== PostgreSQL + pgvector 数据库 ====================
PG_DB_HOST=localhost
PG_DB_PORT=5432
PG_DB_DATABASE=novel_agent
PG_DB_USER=novel_agent
PG_DB_PASSWORD=your_password_here
PG_SSL_MODE=prefer  # 本地开发 prefer；生产用 require 或 verify-ca
PG_CONN_MAX_AGE=600

# ==================== Redis 缓存 + Celery Broker ====================
REDIS_DB_HOST=localhost
REDIS_DB_PORT=6379
REDIS_DB_PASSWORD=
# Redis DB 0: Django cache; DB 1: Celery (settings.py 里自动 +1 隔离)
REDIS_DB_DB=0

# ==================== Embedding 向量化 ====================
# 优先连接 Docker Embedding 服务
EMBEDDING_DOCKER_URL=http://localhost:8080/embed
EMBEDDING_DOCKER_TIMEOUT=30
# ，不可用则 fallback 到 云 API
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_BASE_URL=https://api.deepseek.com
EMBEDDING_MODEL=deepseek-v4-flash
EMBEDDING_DIM=1024

# ==================== HuggingFace 镜像源 ====================
HF_ENDPOINT=https://hf-mirror.com

# ==================== Celery（可选，基本用 settings.py 默认即可） ====================
# CELERY_BROKER_URL=redis://:password@redis:6379/1
# CELERY_TASK_TIME_LIMIT=3600
# CELERY_BEAT_SYNC_EVERY=60
